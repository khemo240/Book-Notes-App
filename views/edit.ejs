<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Book</title>
  <link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
  <main class="app-shell">
    <section class="panel panel-form">
      <h1>Edit Book</h1>
      <form action="/edit-book/<%= book.id %>" method="POST" class="card form-card">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= book.title %>" required />

        <label for="author">Author</label>
        <input type="text" id="author" name="author" value="<%= book.author %>" required />

        <label for="isbn">ISBN</label>
        <input type="text" id="isbn" name="isbn" value="<%= book.isbn %>" required />

        <label for="recommend">Rating</label>
        <input type="number" id="recommend" name="recommend" min="0" max="10" value="<%= book.recommend %>" />

        <label for="date_read">Date Read</label>
        <input type="date" id="date_read" name="date_read" value="<%= book.date_read ? (book.date_read instanceof Date ? book.date_read.toISOString().split('T')[0] : book.date_read) : '' %>" />

        <label for="about">Notes about the book</label>
        <textarea id="about" name="about" rows="3"><%= book.about %></textarea>

        <div class="edit-actions">
          <button type="submit">Save Changes</button>
          <a href="/" class="cancel-link">Cancel</a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>